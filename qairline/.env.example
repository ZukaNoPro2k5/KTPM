# ============================================
# QAIRLINE MICROSERVICES - DATABASE CONFIG
# ============================================
# Copy file này thành .env trong mỗi service folder
# Sau đó update các giá trị phù hợp với môi trường của bạn

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MySQL/MariaDB connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=Flight

# ============================================
# SERVICE-SPECIFIC CONFIGURATION
# ============================================
# Port cho service này
# User Service: 5001
# Flight Service: 5002
# Booking Service: 5003
# Offer Service: 5004
PORT=5001

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
# JWT Secret Key (nên dùng string dài và random trong production)
JWT_SECRET=secret_key
JWT_EXPIRES_IN=1h

# ============================================
# API GATEWAY CONFIGURATION
# ============================================
# URL của API Gateway (nếu có)
API_GATEWAY_URL=http://localhost:3000

# ============================================
# SERVICE URLS (for inter-service communication)
# ============================================
# URL của các services khác
USER_SERVICE_URL=http://localhost:5001
FLIGHT_SERVICE_URL=http://localhost:5002
BOOKING_SERVICE_URL=http://localhost:5003
OFFER_SERVICE_URL=http://localhost:5004

# ============================================
# EMAIL CONFIGURATION (for Offer Service)
# ============================================
# SMTP settings cho việc gửi email notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=QAirline <noreply@qairline.com>

# ============================================
# LOGGING & MONITORING
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins for CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ============================================
# PRODUCTION vs DEVELOPMENT
# ============================================
NODE_ENV=development
# NODE_ENV=production

# ============================================
# DOCKER CONFIGURATION (optional)
# ============================================
# Nếu chạy trong Docker, dùng service names thay vì localhost
# DB_HOST=mysql
# USER_SERVICE_URL=http://user-service:5001
# FLIGHT_SERVICE_URL=http://flight-service:5002
# BOOKING_SERVICE_URL=http://booking-service:5003
# OFFER_SERVICE_URL=http://offer-service:5004

# ============================================
# NOTES
# ============================================
# 1. KHÔNG COMMIT file .env vào git (đã có trong .gitignore)
# 2. Trong production, dùng environment variables thay vì .env file
# 3. DB_PASSWORD nên được encrypt hoặc dùng secrets management
# 4. JWT_SECRET phải là string dài và random trong production
# 5. EMAIL_PASSWORD: Với Gmail, dùng "App Password" thay vì password thường
