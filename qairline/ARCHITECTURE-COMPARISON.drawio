          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-old-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;strokeWidth=3;strokeColor=#b85450;" edge="1" parent="1-comp" source="old-db-access" target="old-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- New Side -->
