        <mxCell id="1-comp" parent="0-comp" />
        <!-- Title -->
        <mxCell id="title-comp" value="&lt;h1&gt;SO SÁNH KIẾN TRÚC&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1-comp">
